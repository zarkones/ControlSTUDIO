{
    "publicKey": {
        "encodings": [
            "hex",
            "pem"
        ],
        "value": ""
    },

    "tick": {
        "sleepMin": 3000,
        "sleepMax": 3000
    },

    "outcall": {
        "id": {
            "operations": [
                { "action": "hex" },
                { "action": "prefix", "value": ["cache-sum5="] }
            ],
            "placement": {
                "header": "User-Agent"
            }
        },
        "payload": {
            "operations": [
                { "action": "hex" },
                { "action": "csv" }
            ],
            "placement": {
                "body": true
            }
        },
        "timeout": 10000,
        "hosts": [
            "http://127.0.0.1:8080"
        ],
        "routes": [
            "/v1/messages",
            "sending"
        ],
        "headers": {
            "Host": [
                "example.com",
                "something.net"
            ],
            "User-Agent": [
                "totally chrome"
            ]
        },
         "methods": [
            "POST",
            "PUT"
        ]
    },

    "incall": {
        "id": {
            "operations": [
                { "action": "hex" }
            ],
            "placement": {
                "urlParam": "xyz"
            }
        },
        "payload": {
            "operations": [
                { "action": "csv_d" },
                { "action": "hex_d" }
            ]
        },
        "timeout": 10000,
        "hosts": [
            "http://127.0.0.1:8080"
        ],
        "routes": [
            "/v1/messages",
            "something"
        ],
        "headers": {
            "Host": [
                "example.com",
                "something.net"
            ],
            "X-custom-Header": [
                "xyz"
            ],
            "X-custom2": [
                "123",
                "345",
                "678"
            ],
            "User-Agent": [
                "totally chrome"
            ]
        },
        "methods": [
            "GET"
        ],
        "urlParams": {
            "xyz": [
                "123",
                "abc"
            ],
            "abc": [
                "xyz"
            ]
        }
    }
}